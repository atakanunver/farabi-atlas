{
  "name": "farabi-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": ".venv/bin/python -m pytest tests/test_atlas.py -q",
    "test:browser": "node tests/browser.mjs",
    "data": ".venv/bin/python scripts/build_data.py && .venv/bin/python scripts/build_tiles.py"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "d3-geo": "^3.1.1",
    "pmtiles": "^4.3.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
